include LICENSE
include .pre-commit-config.yaml
include CITATION.cff
include README.md
include automation.md
include CONTRIBUTING.md
include REPORTING_BUGS.md
include FEATURE_REQUESTS.md
recursive-include docs *.md
prune tests
prune benchmarks
prune docs/_build_html
recursive-include docs/_build_html/_sources *.py *.json *.html *.txt *.css *.js *.ico *.png
prune artifacts
prune .pytest_cache
prune .ruff_cache
global-exclude __pycache__ *.py[cod] *.so *.pyd .env *creds*
